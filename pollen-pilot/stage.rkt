#lang racket/base
(require racket/file racket/path racket/list racket/string racket/runtime-path json)
(define-runtime-path pilot ".")
(define root (build-path pilot 'up "content"))
(define parts '("part-1" "part-2" "part-3" "part-4" "part-5" "part-6" "part-7" "appendix"))
(define (stage source relative)
  (define text (file->string source))
  (define heading (regexp-match #px"(?m:^# +([^\r\n]+))" text))
  (unless heading (error 'stage "Missing title: ~a" source))
  (define target (build-path pilot relative "index.html.pmd"))
  (make-parent-directory* target)
  (display-to-file (string-append "#lang pollen\n" (string-replace text "◊" "◊|\"◊\"|"))
                   target #:exists 'truncate/replace)
  (hasheq 'slug relative 'title (string-trim (cadr heading))
          'url (string-append relative "/") 'text text))
(define entries
  (cons (stage (build-path root "preface.mdx") "book/preface")
        (for*/list ([part (in-list parts)]
                    [file (in-list (sort (filter (lambda (p) (regexp-match? #px"^[0-9]+[.]mdx?$" (path->string p)))
                                                 (directory-list (build-path root part)))
                                         < #:key (lambda (p) (string->number (path->string (path-replace-extension p #""))))))])
          (define slug (path->string (path-replace-extension file #"")))
          (stage (build-path root part file) (string-append "book/" part "/chapter/" slug)))))
(unless (= 64 (length entries)) (error 'stage "Expected 64 source pages; got ~a" (length entries)))
(call-with-output-file (build-path pilot "chapters.js")
  (lambda (out) (display "window.BOOK_CHAPTERS = " out) (write-json entries out) (display ";\n" out))
  #:exists 'truncate/replace)
(printf "Staged ~a pages; MDX semantics still require audit.\n" (length entries))
